---
import AiLabel from '../components/AiLabel.astro';
import CategoryLabel from '../components/CategoryLabel.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { Category } from '../components/outbox/outbox';
import type { AiLabel as AiLabelValue } from '../data/ai-label';
import type { Post } from '../data/posts';
import PostShell from './PostShell.astro';

interface Props {
	title: string;
	description?: string;
	pubDate?: Date;
	updatedDate?: Date;
	category: Category;
	ai?: AiLabelValue;
	related?: Post[];
}

const { title, description, pubDate, updatedDate, category, ai, related } =
	Astro.props;
---

<PostShell title={title} description={description} related={related}>
	<!-- Same 1:3 split as the outbox rows: the category sits in the narrow
	     column, everything you read lines up on the wide one. -->
	<article class="post-grid gap-y-2 md:items-baseline">
		<CategoryLabel
			category={category}
			class="type-body-small text-text-secondary"
		/>
		<div class="flex flex-col gap-1">
			<h1 class="type-heading-3 text-text-primary">{title}</h1>
			{
				(pubDate ?? updatedDate ?? ai) && (
					<p class="type-body-small text-text-third">
						{pubDate && <FormattedDate date={pubDate} />}
						{updatedDate && (
							<span class="text-text-inactive">
								{pubDate && ' · '}Updated{' '}
								<FormattedDate date={updatedDate} />
							</span>
						)}
						{ai && (
							<>
								{(pubDate ?? updatedDate) && ' · '}
								<AiLabel label={ai} class="align-bottom" />
							</>
						)}
					</p>
				)
			}
		</div>
		<div class="prose text-text-secondary md:col-start-2">
			<slot />
		</div>
	</article>
</PostShell>
