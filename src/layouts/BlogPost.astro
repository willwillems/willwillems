---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description?: string;
	pubDate?: Date;
	updatedDate?: Date;
	category?: string;
}

const { title, description = '', pubDate, updatedDate, category } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="mx-auto max-w-5xl px-6 sm:px-8">
			<article class="max-w-2xl py-6 sm:py-8 pb-16">
				<div class="type-body-small mb-2 text-text-third">
					{category}
					{pubDate && <FormattedDate date={pubDate} />}
					{
						updatedDate && (
							<span class="italic">
								— updated <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</div>
				<h1 class="type-heading-1 mb-6 font-normal text-text-secondary">
					{title}
				</h1>
				<div class="prose text-text-secondary">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
