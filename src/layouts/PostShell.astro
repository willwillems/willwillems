---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import type { Post } from '../data/posts';

/**
 * Page chrome shared by every post layout. Layouts render the article into
 * the slot; related posts always follow it on the same 1:3 grid.
 */
interface Props {
	title: string;
	description?: string;
	related?: Post[];
}

const { title, description = '', related = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="mx-auto max-w-5xl px-6 sm:px-8 pt-6 sm:pt-10">
			<slot />
			<RelatedPosts posts={related} />
		</main>
		<Footer />
	</body>
</html>
