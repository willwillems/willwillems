---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Thanks — ${SITE_TITLE}`}
			description="Your message is on its way."
		/>
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<Header />
		<main class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-16 sm:px-8">
			<h1 class="type-title text-text-primary">
				Thanks for saying hello
			</h1>
			<p class="type-body-small text-text-third">
				Your message is on its way, I'll get back to you soon.
				<a href="/" class="text-text-primary">Back home</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
