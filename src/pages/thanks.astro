---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Thanks — ${SITE_TITLE}`}
			description="Your message is on its way."
		/>
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<Header />
		<main class="mx-auto flex max-w-5xl flex-col gap-2 px-6 py-16 sm:px-8">
			<p class="type-body max-w-xl text-text-secondary">
				Thanks for saying hello. Your message is on its way and I'll get
				back to you soon.
			</p>
			<p class="type-body">
				<span class="type-accent">Will</span>
			</p>
		</main>
		<Footer />
	</body>
</html>
