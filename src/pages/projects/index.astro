---
import BaseHead from '../../components/BaseHead.astro';
import FilterTabs from '../../components/projects/FilterTabs.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import ProjectsGrid from '../../components/projects/ProjectsGrid.astro';
import { projects } from '../../data/projects';

import { SITE_TITLE } from '../../consts';

const filterTabs = [
	{ label: 'All', href: '/projects', active: true },
	{ label: 'Active', href: '/projects?filter=active' },
	{ label: 'Experimental', href: '/projects?filter=experimental' },
	{ label: 'Dead', href: '/projects?filter=dead' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Projects - ${SITE_TITLE}`}
			description="Projects and work"
		/>
	</head>
	<body>
		<main class="mx-auto max-w-5xl px-8 pt-4">
			<div class="mb-12 flex items-baseline justify-between">
				<h1 class="text-base font-medium text-text">Projects</h1>
				<FilterTabs tabs={filterTabs} />
			</div>
			<ProjectsGrid>
				{
					projects.map((project) => (
						<ProjectCard
							name={project.name}
							description={project.description}
							href={project.link}
						/>
					))
				}
			</ProjectsGrid>
		</main>
	</body>
</html>
