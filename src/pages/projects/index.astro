---
import BaseHead from '../../components/BaseHead.astro';
import FilterTabs from '../../components/projects/FilterTabs.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import ProjectsGrid from '../../components/projects/ProjectsGrid.astro';

import { SITE_TITLE } from '../../consts';

const filterTabs = [
	{ label: 'All', href: '/projects', active: true },
	{ label: 'Publication', href: '/projects?filter=publication' },
];

const projects = [
	{
		name: 'Devsync',
		description: 'Sink your ass to your browser. ',
		href: '#',
		verified: true,
	},
	{
		name: 'Devsync',
