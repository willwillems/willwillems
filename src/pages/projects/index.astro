---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Projects - ${SITE_TITLE}`}
			description="Projects and work"
		/>
	</head>
	<body>
		<main class="mx-auto max-w-5xl px-8 pt-4">
			<div class="mb-12 flex items-baseline justify-between">
				<h1 class="text-base font-medium text-text">Projects</h1>
				<FilterTabs tabs={filterTabs} />
			</div>
			<ProjectsGrid>
				{projects.map((project) => <ProjectCard {...project} />)}
			</ProjectsGrid>
		</main>
	</body>
</html>
