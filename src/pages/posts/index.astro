---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import OutboxSection from '../../components/outbox/OutboxSection.astro';
import { getOutboxPosts } from '../../data/posts';
import { SITE_TITLE } from '../../consts';

const posts = await getOutboxPosts();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Outbox — ${SITE_TITLE}`}
			description="Short notes, reports, and resources."
		/>
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-5xl px-8 pt-4 pb-12">
			<OutboxSection posts={posts} />
		</main>
		<Footer />
	</body>
</html>
