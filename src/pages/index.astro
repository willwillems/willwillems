---
import BaseHead from '../components/BaseHead.astro';
import FullBleed from '../components/FullBleed.astro';
import Header from '../components/Header.astro';
import HeaderLink from '../components/HeaderLink.astro';

import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header>
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="#articles">Articles</HeaderLink>
			<HeaderLink href="#projects">Projects</HeaderLink>
			<HeaderLink href="#posts">Posts</HeaderLink>
		</Header>
		<main>
			<FullBleed as="section" class="hero">
				<div class="hero-content">
					<div class="hero-text">
						<p class="hero-greeting">Hi there, I'm <strong>Will</strong></p>
						<p class="hero-description">
							Passionate developer and web development consultant. I'm currently
							obsessed with creating blazing fast modern web apps.
						</p>
					</div>
					<div class="hero-image">
						<div class="image-container">
							<div class="image-placeholder">
								<span>Image</span>
							</div>
						</div>
					</div>
				</div>
			</FullBleed>
		</main>
	</body>
</html>

<style>
	.hero {
		min-height: 100vh;
		background-color: var(--bg-dark);
		padding-inline: var(--layout-inline-padding);
	}

	.hero-content {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: 4rem;
		width: min(87.5rem, 100%);
		margin-inline: auto;
		min-height: calc(100vh - 100px);
		padding: 2rem 0;
	}

	.hero-text {
		max-width: 500px;
	}

	.hero-greeting {
		font-size: 1.25rem;
		color: var(--text-secondary);
		margin-bottom: 0.5rem;
	}

	.hero-greeting strong {
		color: var(--text-primary);
	}

	.hero-description {
		font-size: 1.25rem;
		color: var(--text-secondary);
		line-height: 1.7;
		margin: 0;
	}

	.hero-image {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.image-container {
		position: relative;
		width: 100%;
		max-width: 450px;
	}

	.image-placeholder {
		width: 100%;
		aspect-ratio: 3 / 4;
		background: linear-gradient(135deg, #2a2a2a 0%, #1a1a1a 100%);
		border-radius: 2rem 2rem 2rem 0.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-secondary);
		font-size: 1.5rem;
		overflow: hidden;
	}

	.image-placeholder img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 1024px) {
		.hero-content {
			grid-template-columns: 1fr;
			text-align: center;
			gap: 3rem;
		}

		.hero-text {
			max-width: 100%;
			order: 1;
		}

		.hero-image {
			order: 0;
		}

		.image-container {
			max-width: 350px;
		}
	}

	@media (max-width: 768px) {
		.hero-greeting,
		.hero-description {
			font-size: 1.1rem;
		}

		.image-container {
			max-width: 280px;
		}
	}
</style>
