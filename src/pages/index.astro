---
import BaseHead from '../components/BaseHead.astro';
import FullBleed from '../components/FullBleed.astro';
import Header from '../components/Header.astro';
import HeaderLink from '../components/HeaderLink.astro';

import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header>
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="#articles">Articles</HeaderLink>
			<HeaderLink href="#projects">Projects</HeaderLink>
			<HeaderLink href="#posts">Posts</HeaderLink>
		</Header>
		<main>
			<section class="section hero">
				<p class="hero__text">
					Hi there, I'm <strong>Will</strong>
					Passionate developer and web development consultant. I'm currently
					obsessed with creating blazing fast modern web apps.
				</p>
				<div class="hero__portrait">
					<img src="/img/hero-image.jpg" alt="Will reading at a bar" />
				</div>
			</section>
		</main>
	</body>
</html>

<style>
	p {
		line-height: 1.7;
	}
	.section {
		padding: 2rem;
	}

	.hero {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		align-items: center;
		gap: 4rem;

		min-height: calc(100dvh - 5rem);
		padding-block: 2rem;
		
		font-size: 1.25rem;

		.hero__portrait {
			aspect-ratio: 9 / 10;
			background: linear-gradient(135deg, #2a2a2a, #1a1a1a);
			border-radius: 1.5rem;
			overflow: hidden;

			img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
		}
	}
</style>
