---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import ImageCarousel from '../components/ImageCarousel.astro';

import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const heroImages = [
	{ src: '/img/hero-carousel-1.jpg', alt: 'Will at a table' },
	{ src: '/img/hero-carousel-2.jpg', alt: 'Mountain landscape with friends' },
	{ src: '/img/hero-image.jpg', alt: 'Will reading at a bar' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero__carousel">
					<ImageCarousel images={heroImages} />
				</div>
				<p class="hero__text">
					Hi there, I'm <span class="hero__name">Will</span>
					<br /><br />
					I work at <strong>Deducta</strong> as a product engineer. Previously
					I worked on <strong>Devsync</strong>. In addition to
					engineering on the web, I've always been obsessed with <em
						>creative hardware interfaces</em
					> with a specific focus on <span class="hero__accent"
						>audio</span
					>.
				</p>
			</section>
		</main>
	</body>
</html>

<style>
	p {
		line-height: 1.7;
	}

	main {
		max-width: var(--layout-content-max);
		margin-inline: auto;
		padding-inline: var(--layout-inline-padding);
	}

	.hero {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding-block: 2rem;
	}

	.hero__text {
		font-size: 1.25rem;

		strong {
			font-weight: 600;
		}

		em {
			font-style: normal;
			font-weight: 500;
		}
	}

	.hero__name {
		font-family: 'Gochi Hand', cursive;
		font-size: 1.55rem;
	}

	.hero__accent {
		font-family: 'Gochi Hand', cursive;
		font-size: 1.55rem;
	}
</style>
