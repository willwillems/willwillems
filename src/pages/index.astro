---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImageCarousel from '../components/ImageCarousel.astro';
import ArrowRight from '../components/icons/ArrowRight.astro';
import GitHub from '../components/icons/GitHub.astro';

import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const heroImages = [
	{ src: '/img/hero-carousel-1.jpg', alt: 'Will at a table' },
	{ src: '/img/hero-carousel-2.jpg', alt: 'Mountain landscape with friends' },
	{ src: '/img/hero-image.jpg', alt: 'Will reading at a bar' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-5xl px-8">
			<section class="flex flex-col gap-8 py-8">
				<ImageCarousel images={heroImages} />
				<p class="text-lg leading-[1.7]">
					Hi there, I'm <span class="font-accent text-[1.35em]"
						>Will</span
					>
					<br />
					<br />
					I work at <strong class="font-semibold">Deducta</strong> as a
					product engineer. Previously I worked on <strong
						class="font-semibold">Devsync</strong
					>. In addition to engineering on the web, I've always been
					obsessed with <em class="not-italic font-medium"
						>creative hardware interfaces</em
					> with a specific focus on <span
						class="font-accent text-[1.35em]">audio</span
					>.
				</p>
			</section>

			<section class="flex flex-col gap-8 py-16">
				<div class="flex flex-col gap-8">
					<div class="flex items-start justify-between">
						<h2 class="text-base font-medium">Say hello</h2>
						<a
							href="#"
							class="flex items-center gap-2.5 text-text-secondary hover:text-text transition-colors"
						>
							<span class="text-base font-medium">Send</span>
							<ArrowRight />
						</a>
					</div>

					<div class="flex flex-wrap gap-8">
						<div class="flex w-48 shrink-0 flex-col gap-4">
							<label
								class="text-sm font-medium"
								for="contact-email">Email</label
							>
							<input
								id="contact-email"
								type="email"
								placeholder="john@hd.com"
								class="bg-transparent text-sm text-text-secondary placeholder:text-text-secondary outline-none"
							/>
						</div>
						<div class="flex min-w-64 flex-1 flex-col gap-4">
							<label
								class="text-sm font-medium"
								for="contact-message">Message</label
							>
							<textarea
								id="contact-message"
								rows="3"
								placeholder="Write your message here..."
								class="bg-transparent text-sm leading-[1.7] text-text-secondary placeholder:text-text-secondary outline-none resize-none"
							></textarea>
						</div>
					</div>
				</div>

				<div class="flex flex-col gap-6">
					<p class="text-base font-medium">Or</p>
					<a
						href="https://github.com/nicepkg"
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-3 text-sm font-medium hover:text-text-secondary transition-colors"
					>
						<GitHub />
						Ping me on GH
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
