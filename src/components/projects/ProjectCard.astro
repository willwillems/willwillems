---
import VerifiedBadge from '../icons/VerifiedBadge.astro';
import ExternalLink from '../icons/ExternalLink.astro';

interface Props {
	name: string;
	description: string;
	href?: string;
	verified?: boolean;
}

const { name, description, href, verified = false } = Astro.props;
---

<article class="flex items-center gap-6">
	<div
		class="size-14 shrink-0 rounded-[11px] border border-border bg-surface"
		aria-hidden="true"
	>
	</div>
	<div class="flex min-w-0 flex-1 flex-col gap-1">
		<div class="flex items-center gap-3">
			<p class="text-base font-medium text-text">{name}</p>
			{verified && <VerifiedBadge class="shrink-0" />}
		</div>
		<p class="text-base font-medium text-text-secondary">{description}</p>
	</div>
	{
		href && (
			<a
				class="ml-auto flex shrink-0 items-center justify-center"
				href={href}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`Open ${name}`}
			>
				<ExternalLink />
			</a>
		)
	}
</article>
