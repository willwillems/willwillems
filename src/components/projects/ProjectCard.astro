---
import VerifiedBadge from '../icons/VerifiedBadge.astro';
import ExternalLink from '../icons/ExternalLink.astro';
import LabExperiment from '../icons/LabExperiment.astro';
import type { ProjectStatus } from '../../data/projects';

interface Props {
	name: string;
	description: string;
	href?: string;
	verified?: boolean;
	status?: ProjectStatus;
	icon?: string;
}

const { name, description, href, verified = false, status, icon } = Astro.props;
---

<article class="flex items-center gap-6">
	<div
		class="size-14 shrink-0 overflow-hidden rounded-xl border border-border bg-surface"
		aria-hidden="true"
	>
		{icon && <img class="size-full object-cover" src={icon} alt="" />}
	</div>
	<div class="flex min-w-0 flex-1 flex-col gap-1">
		<div class="flex items-center gap-3">
			<p class="type-title text-text-primary">{name}</p>
			{verified && <VerifiedBadge class="shrink-0" />}
			{status === 'experiment' && <LabExperiment class="shrink-0" />}
		</div>
		<p class="type-body text-text-third">{description}</p>
	</div>
	{
		href && (
			<a
				class="ml-auto flex shrink-0 items-center justify-center"
				href={href}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`Open ${name}`}
			>
				<ExternalLink />
			</a>
		)
	}
</article>
