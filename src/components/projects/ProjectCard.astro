---
interface Props {
	name: string;
	description: string;
	href?: string;
	verified?: boolean;
}

const { name, description, href, verified = false } = Astro.props;
---

<article class="project-card">
	<div class="project-card__icon" aria-hidden="true"></div>
	<div class="project-card__info">
		<div class="project-card__title-row">
			<p class="project-card__name">{name}</p>
			{
				verified && (
					<svg
						class="project-card__badge"
						width="16"
						height="16"
						viewBox="0 0 16 16"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
						aria-label="Verified"
					>
						<circle cx="8" cy="8" r="8" fill="#5A83FF" fill-opacity="0.39" />
						<g clip-path="url(#badge-clip)">
							<path
								d="M7.25 5.03467V6.93933C7.25 7.03783 7.2306 7.13535 7.19291 7.22635C7.15522 7.31734 7.09998 7.40002 7.03033 7.46967L5.66667 8.83333M7.25 5.03467C7.16633 5.04233 7.083 5.05133 7 5.062M7.25 5.03467C7.74892 4.98827 8.25108 4.98827 8.75 5.03467M5.66667 8.83333L5.92333 8.769C6.621 8.5966 7.35727 8.6785 8 9C8.64273 9.3215 9.379 9.4034 10.0767 9.231L10.6 9.1M5.66667 8.83333L4.93267 9.56767C4.52167 9.978 4.71567 10.6733 5.28833 10.771C6.16967 10.9217 7.07567 11 8 11C8.90873 11.0003 9.81586 10.9237 10.7117 10.771C11.284 10.6733 11.478 9.978 11.0673 9.56733L10.6 9.1M8.75 5.03467V6.93933C8.75 7.13833 8.829 7.32933 8.96967 7.46967L10.6 9.1M8.75 5.03467C8.83367 5.04233 8.917 5.05133 9 5.062"
								stroke="#4F6CD4"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</g>
						<defs>
							<clipPath id="badge-clip">
								<rect
									width="8"
									height="8"
									fill="white"
									transform="translate(4 4)"
								/>
							</clipPath>
						</defs>
					</svg>
				)
			}
		</div>
		<p class="project-card__description">{description}</p>
	</div>
	{
		href && (
			<a
				class="project-card__link"
				href={href}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`Open ${name}`}
			>
				<svg
					width="16"
					height="16"
					viewBox="0 0 16 16"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<path
						fill-rule="evenodd"
						clip-rule="evenodd"
						d="M3.4 4.4C3.24087 4.4 3.08826 4.46321 2.97574 4.57574C2.86321 4.68826 2.8 4.84087 2.8 5V11.8C2.8 12.1312 3.0688 12.4 3.4 12.4H10.2C10.3591 12.4 10.5117 12.3368 10.6243 12.2243C10.7368 12.1117 10.8 11.9591 10.8 11.8V8.6C10.8 8.44087 10.8632 8.28826 10.9757 8.17574C11.0883 8.06322 11.2409 8 11.4 8C11.5591 8 11.7117 8.06322 11.8243 8.17574C11.9368 8.28826 12 8.44087 12 8.6V11.8C12 12.2774 11.8104 12.7352 11.4728 13.0728C11.1352 13.4104 10.6774 13.6 10.2 13.6H3.4C2.92261 13.6 2.46477 13.4104 2.12721 13.0728C1.78964 12.7352 1.6 12.2774 1.6 11.8V5C1.6 4.52261 1.78964 4.06477 2.12721 3.72721C2.46477 3.38964 2.92261 3.2 3.4 3.2H7.4C7.55913 3.2 7.71174 3.26321 7.82426 3.37574C7.93679 3.48826 8 3.64087 8 3.8C8 3.95913 7.93679 4.11174 7.82426 4.22426C7.71174 4.33679 7.55913 4.4 7.4 4.4H3.4Z"
						fill="#757575"
					/>
					<path
						fill-rule="evenodd"
						clip-rule="evenodd"
						d="M4.9552 10.2024C5.00807 10.2609 5.07195 10.3084 5.1432 10.3422C5.21444 10.376 5.29165 10.3954 5.37041 10.3994C5.44917 10.4033 5.52793 10.3917 5.60219 10.3652C5.67645 10.3386 5.74476 10.2977 5.8032 10.2448L13.2 3.552V5.8C13.2 5.95913 13.2632 6.11174 13.3757 6.22426C13.4883 6.33679 13.6409 6.4 13.8 6.4C13.9591 6.4 14.1117 6.33679 14.2243 6.22426C14.3368 6.11174 14.4 5.95913 14.4 5.8V2.2C14.4 2.04087 14.3368 1.88826 14.2243 1.77574C14.1117 1.66321 13.9591 1.6 13.8 1.6H10.2C10.0409 1.6 9.88826 1.66321 9.77574 1.77574C9.66321 1.88826 9.6 2.04087 9.6 2.2C9.6 2.35913 9.66321 2.51174 9.77574 2.62426C9.88826 2.73679 10.0409 2.8 10.2 2.8H12.2424L4.9976 9.3552C4.93909 9.40807 4.89158 9.47195 4.85778 9.5432C4.82398 9.61444 4.80456 9.69165 4.80062 9.77041C4.79668 9.84917 4.80831 9.92793 4.83483 10.0022C4.86135 10.0765 4.90226 10.144 4.9552 10.2024Z"
						fill="#757575"
					/>
				</svg>
			</a>
		)
	}
</article>

<style>
	.project-card {
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.project-card__icon {
		flex-shrink: 0;
		width: 56px;
		height: 56px;
		background: #333;
		border: 1px solid #3f3f3f;
		border-radius: 11px;
	}

	.project-card__info {
		display: flex;
		flex-direction: column;
		gap: 4px;
		flex: 1;
		min-width: 0;
	}

	.project-card__title-row {
		display: flex;
		align-items: center;
		gap: 11px;
	}

	.project-card__name {
		font-family: 'Inter', sans-serif;
		font-weight: 500;
		font-size: 16px;
		line-height: normal;
		color: white;
	}

	.project-card__badge {
		flex-shrink: 0;
	}

	.project-card__description {
		font-family: 'Inter', sans-serif;
		font-weight: 500;
		font-size: 16px;
		line-height: normal;
		color: #a2a2a2;
	}

	.project-card__link {
		margin-left: auto;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 16px;
		height: 16px;
	}
</style>
