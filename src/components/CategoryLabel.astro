---
import CategorySwatch from './CategorySwatch.astro';
import type { Category } from './outbox/outbox';

interface Props {
	category: Category;
	class?: string;
}

const { category, class: className } = Astro.props;
---

<span class:list={['flex items-center gap-3', className]}>
	<CategorySwatch category={category} />
	{category}
</span>
