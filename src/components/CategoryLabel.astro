---
import { type Category, CATEGORY_COLORS } from './outbox/outbox';

interface Props {
	category: Category;
	class?: string;
}

const { category, class: className } = Astro.props;
---

<span class:list={['flex items-center gap-3', className]}>
	<span
		class="size-3 shrink-0 rounded-[1px]"
		style={`background: ${CATEGORY_COLORS[category]}`}
		aria-hidden="true"></span>
	{category}
</span>
