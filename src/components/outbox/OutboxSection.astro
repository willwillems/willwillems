---
import ActivityHeatmap from './ActivityHeatmap.astro';
import OutboxHeader from './OutboxHeader.astro';
import PostList from './PostList.astro';
import type { Post } from '../../data/posts';
import {
	buildCategoryColorMap,
	buildHeatmapBuckets,
	countByCategory,
	deriveCategories,
} from './outbox';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;

// Undated posts sort to the end of the default (newest-first) order.
const orderedPosts = [...posts].sort(
	(a, b) => (b.publishedAt?.valueOf() ?? 0) - (a.publishedAt?.valueOf() ?? 0),
);

const categories = deriveCategories(posts);
const categoryColors = buildCategoryColorMap(categories);
const buckets = buildHeatmapBuckets(posts, categories);
const counts = countByCategory(posts);
---

<section class="flex flex-col gap-10" data-outbox-section>
	<div class="flex flex-col gap-8">
		<OutboxHeader
			categories={categories}
			categoryColors={categoryColors}
			counts={counts}
			total={posts.length}
		/>
		<ActivityHeatmap buckets={buckets} categoryColors={categoryColors} />
	</div>
	<PostList posts={orderedPosts} />
</section>

<script>
	type RowEl = HTMLElement;

	function init(section: HTMLElement) {
		const tabsContainer =
			section.querySelector<HTMLElement>('[data-outbox-tabs]');
		const menu = section.querySelector<HTMLElement>('#outbox-filter-menu');
		const filterMenu = menu?.querySelector<HTMLElement>(
			'[data-outbox-filter-options]',
		);
		const filterTrigger = section.querySelector<HTMLElement>(
			'[data-outbox-filter-trigger]',
		);
		const filterLabel = section.querySelector<HTMLElement>(
			'[data-outbox-filter-label]',
		);
		const filterDot = section.querySelector<HTMLElement>(
			'[data-outbox-filter-dot]',
		);
		const sortButton =
			section.querySelector<HTMLButtonElement>('[data-outbox-sort]');
		const sortIcon = section.querySelector<SVGElement>(
			'[data-outbox-sort-icon]',
		);
		const listContainer =
			section.querySelector<HTMLElement>('[data-outbox-list]');
		const emptyState = section.querySelector<HTMLElement>(
			'[data-outbox-empty]',
		);

		if (!tabsContainer || !sortButton || !listContainer) return;
		const list = listContainer;

		const rows = Array.from(
			list.querySelectorAll<RowEl>('[data-outbox-row]'),
		);

		let activeCategory = '';
		let direction: 'asc' | 'desc' = 'desc';

		// Dates whose posts the heatmap snake has eaten. The heatmap announces
		// every change via a bubbling `outbox:eaten-changed` event; rows whose
		// publish date is in the set are removed from the list regardless of
		// category.
		let eatenDates = new Set<string>();
		const defaultEmptyText = emptyState?.textContent?.trim() ?? '';
		const reducedMotion = window.matchMedia(
			'(prefers-reduced-motion: reduce)',
		);

		// Sync the DOM to the rows that should currently be shown, in sort
		// order. Eaten/filtered-out rows are detached entirely (not just
		// hidden) so the `[data-outbox-row] + &` divider rule only ever sees
		// visible siblings — the first visible row keeps its clean top edge.
		// Every row carries a stable `view-transition-name`, so wrapping the
		// mutation in a view transition fades removed rows out and slides the
		// survivors up for free. `rows` retains references to detached nodes,
		// so filtering a category back on (or a game restart) re-inserts them.
		function reconcile(animate = false) {
			const sorted = [...rows].sort((a, b) => {
				const da = a.dataset.date ?? '';
				const db = b.dataset.date ?? '';
				return direction === 'asc'
					? da.localeCompare(db)
					: db.localeCompare(da);
			});

			const visible: RowEl[] = [];
			let categoryCount = 0;
			for (const row of sorted) {
				const cats = (row.dataset.categories ?? '').split(',');
				const inCategory =
					activeCategory === '' || cats.includes(activeCategory);
				if (inCategory) categoryCount++;
				if (inCategory && !eatenDates.has(row.dataset.date ?? '')) {
					visible.push(row);
				}
			}
			const visibleSet = new Set(visible);

			const swap = () => {
				for (const row of rows) {
					if (!visibleSet.has(row)) row.remove();
				}
				// appendChild moves already-attached nodes, so iterating the
				// visible rows leaves the list in exact sort order.
				for (const row of visible) list.appendChild(row);
				if (emptyState) {
					list.appendChild(emptyState);
					emptyState.hidden = visible.length > 0;
					emptyState.textContent =
						visible.length === 0 && categoryCount > 0
							? 'The snake ate every post here.'
							: defaultEmptyText;
				}
			};

			if (
				animate &&
				document.startViewTransition &&
				!reducedMotion.matches
			) {
				document.startViewTransition(swap);
			} else {
				swap();
			}
		}

		// The desktop tabs and the mobile dropdown are two views of the same
		// filter, so selection is handled once for every `[data-category]`
		// control in the section and mirrored across both.
		function selectCategory(category: string) {
			activeCategory = category;

			for (const control of section.querySelectorAll<HTMLElement>(
				'[data-category]',
			)) {
				control.dataset.active =
					(control.dataset.category ?? '') === category
						? 'true'
						: 'false';
			}

			const selected = filterMenu?.querySelector<HTMLElement>(
				`[data-category="${CSS.escape(category)}"]`,
			);
			if (filterLabel) filterLabel.textContent = category || 'All';
			// Clearing the inline value falls back to the neutral grey in CSS.
			if (filterDot) {
				filterDot.style.background = selected?.dataset.color ?? '';
			}

			reconcile(true);
		}

		for (const container of [tabsContainer, filterMenu]) {
			container?.addEventListener('click', (event) => {
				const target = (
					event.target as HTMLElement
				).closest<HTMLElement>('[data-category]');
				if (!target) return;
				selectCategory(target.dataset.category ?? '');
				menu?.hidePopover();
			});
		}

		// The trigger has no native open state to style against, so mirror the
		// popover's onto it for the chevron flip.
		menu?.addEventListener('toggle', (event) => {
			filterTrigger?.setAttribute(
				'data-open',
				(event as ToggleEvent).newState === 'open' ? 'true' : 'false',
			);
		});

		section.addEventListener('outbox:eaten-changed', (event) => {
			const { dates } = (event as CustomEvent<{ dates: string[] }>)
				.detail;
			eatenDates = new Set(dates);
			reconcile(true);
		});

		sortButton.addEventListener('click', () => {
			direction = direction === 'desc' ? 'asc' : 'desc';
			sortButton.dataset.direction = direction;
			if (sortIcon) {
				sortIcon.style.transform =
					direction === 'asc' ? 'rotate(180deg)' : '';
			}
			reconcile(true);
		});

		// Initial empty-state sync (in case the list is empty on first paint).
		reconcile();
	}

	for (const el of document.querySelectorAll<HTMLElement>(
		'[data-outbox-section]',
	)) {
		init(el);
	}
</script>
