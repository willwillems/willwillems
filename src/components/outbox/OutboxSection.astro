---
import ActivityHeatmap from './ActivityHeatmap.astro';
import OutboxHeader from './OutboxHeader.astro';
import PostList from './PostList.astro';
import type { Post } from '../../data/posts';
import {
	buildCategoryColorMap,
	buildHeatmapBuckets,
	deriveCategories,
} from './outbox';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;

const orderedPosts = [...posts].sort(
	(a, b) => b.publishedAt.valueOf() - a.publishedAt.valueOf(),
);

const categories = deriveCategories(posts);
const categoryColors = buildCategoryColorMap(categories);
const buckets = buildHeatmapBuckets(posts, categories);
---

<section class="flex flex-col gap-6" data-outbox-section>
	<OutboxHeader categories={categories} />
	<ActivityHeatmap buckets={buckets} categoryColors={categoryColors} />
	<PostList posts={orderedPosts} />
</section>

<script>
	type RowEl = HTMLElement;

	function init(section: HTMLElement) {
		const tabsContainer =
			section.querySelector<HTMLElement>('[data-outbox-tabs]');
		const sortButton =
			section.querySelector<HTMLButtonElement>('[data-outbox-sort]');
		const sortIcon = section.querySelector<SVGElement>(
			'[data-outbox-sort-icon]',
		);
		const listContainer =
			section.querySelector<HTMLElement>('[data-outbox-list]');
		const emptyState = section.querySelector<HTMLElement>(
			'[data-outbox-empty]',
		);

		if (!tabsContainer || !sortButton || !listContainer) return;
		const list = listContainer;

		const rows = Array.from(
			list.querySelectorAll<RowEl>('[data-outbox-row]'),
		);

		let activeCategory = '';
		let direction: 'asc' | 'desc' = 'desc';

		function updateVisibility() {
			let visibleCount = 0;
			for (const row of rows) {
				const cats = (row.dataset.categories ?? '').split(',');
				const match =
					activeCategory === '' || cats.includes(activeCategory);
				row.hidden = !match;
				if (match) visibleCount++;
			}
			if (emptyState) {
				emptyState.hidden = visibleCount > 0;
			}
		}

		function applyOrder() {
			const sorted = [...rows].sort((a, b) => {
				const da = a.dataset.date ?? '';
				const db = b.dataset.date ?? '';
				return direction === 'asc'
					? da.localeCompare(db)
					: db.localeCompare(da);
			});
			for (const row of sorted) {
				list.appendChild(row);
			}
			// Keep the empty state at the end of the container.
			if (emptyState) list.appendChild(emptyState);
		}

		tabsContainer.addEventListener('click', (event) => {
			const target = (event.target as HTMLElement).closest<HTMLElement>(
				'[data-category]',
			);
			if (!target) return;
			activeCategory = target.dataset.category ?? '';

			const allTabs =
				tabsContainer.querySelectorAll<HTMLElement>('[data-category]');
			for (const tab of allTabs) {
				const isActive = tab === target;
				tab.dataset.active = isActive ? 'true' : 'false';
				tab.classList.toggle('text-text', isActive);
				tab.classList.toggle('text-text-inactive', !isActive);
				tab.classList.toggle('hover:text-text-secondary', !isActive);
			}

			updateVisibility();
		});

		sortButton.addEventListener('click', () => {
			direction = direction === 'desc' ? 'asc' : 'desc';
			sortButton.dataset.direction = direction;
			if (sortIcon) {
				sortIcon.style.transform =
					direction === 'asc' ? 'rotate(180deg)' : '';
			}
			applyOrder();
		});

		// Initial empty-state sync (in case the list is empty on first paint).
		updateVisibility();
	}

	for (const el of document.querySelectorAll<HTMLElement>(
		'[data-outbox-section]',
	)) {
		init(el);
	}
</script>
