---
import FormattedDate from '../FormattedDate.astro';
import type { Post } from '../../data/posts';
import { excerpt } from './outbox';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const primaryCategory = post.categories[0] ?? '';
const description = excerpt(post.content);
const iso = post.publishedAt.toISOString().slice(0, 10);
---

<article
	class="grid gap-2 py-6 max-md:grid-cols-1 md:grid-cols-[1fr_3fr] md:gap-x-8 [[data-outbox-row]+&]:border-t [[data-outbox-row]+&]:border-border"
	data-outbox-row
	data-categories={post.categories.join(',')}
	data-date={iso}
>
	<div class="flex flex-col gap-4 text-sm">
		<span class="text-sm text-text-primary">{primaryCategory}</span>
		<span class="text-text-inactive type-body-small">
			<FormattedDate date={post.publishedAt} />
		</span>
	</div>
	<div class="flex flex-col gap-4">
		<h3 class="type-title text-text-primary">
			{post.title}
		</h3>
		{
			description && (
				<p class="type-body-small text-text-third">{description}</p>
			)
		}
	</div>
</article>
