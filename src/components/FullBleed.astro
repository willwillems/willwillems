---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
	as?: string;
}

const { as: Tag = 'div', class: className, ...props } = Astro.props;
---

<Tag class:list={['full-bleed', className]} {...props}>
	<slot />
</Tag>

<style>
	.full-bleed {
		width: 100%;
		grid-column: 1 / -1;
		margin-inline: calc(var(--layout-inline-padding) * -1);
	}
</style>
