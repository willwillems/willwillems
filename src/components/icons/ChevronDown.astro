---
interface Props {
	class?: string;
	size?: number;
}

const { class: className, size = 13 } = Astro.props;
---

<svg
	class={className}
	width={size}
	height={Math.round(size * (8 / 13))}
	viewBox="0 0 13 8"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
>
	<path
		d="M11.75 0.750004L6.25 6.75L0.75 0.750004"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		stroke-linejoin="round"></path>
</svg>
