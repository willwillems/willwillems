---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
	images: {
		src: ImageMetadata;
		alt: string;
	}[];
}

const { images } = Astro.props;

const SLOT_WIDTHS = [320, 576];
---

<div
	class="no-scrollbar flex w-full gap-6 snap-x snap-mandatory overflow-x-auto"
>
	{
		images.map((image, i) => {
			const slot = SLOT_WIDTHS[i % 2];
			const widths = [slot, slot * 2, slot * 3]
				.map((w) => Math.min(w, image.src.width))
				.filter((w, idx, all) => all.indexOf(w) === idx);

			return (
				<div
					class:list={[
						'h-100 shrink-0 snap-start overflow-hidden',
						i % 2 === 0 ? 'w-xs' : 'w-xl',
					]}
				>
					<Picture
						class="size-full object-cover"
						src={image.src}
						alt={image.alt}
						formats={['avif', 'webp']}
						widths={widths}
						sizes={`${slot}px`}
						loading={i < 2 ? 'eager' : 'lazy'}
						fetchpriority={i === 0 ? 'high' : 'auto'}
					/>
				</div>
			);
		})
	}
</div>
