---
interface Props {
	images: {
		src: string;
		alt: string;
	}[];
}

const { images } = Astro.props;
---

<div class="flex w-full gap-6 overflow-hidden">
	{
		images.map((image, i) => (
			<div
				class:list={[
					'h-100 shrink-0 overflow-hidden rounded',
					i % 2 === 0 ? 'w-xs' : 'w-2xl',
				]}
			>
				<img
					class="size-full object-cover"
					src={image.src}
					alt={image.alt}
					loading="eager"
				/>
			</div>
		))
	}
</div>
