---
import { SITE_TITLE } from '../consts';
import HeaderLogo from './HeaderLogo.astro';

const navItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Articles', href: '/articles' },
	{ label: 'Projects', href: '/projects' },
	{ label: 'Posts', href: '/posts' },
];

const pathname = Astro.url.pathname;
const currentPage =
	navItems.find(
		(item) =>
			item.href === pathname ||
			(item.href !== '/' && pathname.startsWith(item.href)),
	)?.label ?? 'Menu';
---

<header
	class="mx-auto grid max-w-5xl grid-cols-[auto_1fr_auto] items-center gap-8 px-8 py-6 text-sm"
>
	<div class="flex min-w-12 items-center justify-start">
		<HeaderLogo />
	</div>
	<nav
		class="hidden items-center justify-center gap-12 sm:flex"
		aria-label={`${SITE_TITLE} primary navigation`}
	>
		{
			navItems.map((item) => (
				<a
					href={item.href}
					class:list={[
						'no-underline',
						item.label === currentPage
							? 'text-text'
							: 'text-text-secondary',
					]}
				>
					{item.label}
				</a>
			))
		}
	</nav>
	<div class="flex min-w-12 items-center justify-end sm:hidden">
		<button
			class="flex cursor-pointer items-center gap-2 border-none bg-transparent p-0 text-white"
			popovertarget="mobile-nav"
		>
			<span>{currentPage}</span>
			<svg
				width="13"
				height="8"
				viewBox="0 0 13 8"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
			>
				<path
					d="M11.75 0.750004L6.25 6.75L0.75 0.750004"
					stroke="white"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</button>
	</div>
	<div class="hidden min-w-12 items-center justify-end sm:flex">
		<a href="#" aria-label="Social">
			<svg
				width="16"
				height="16"
				viewBox="0 0 16 16"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
			>
				<path
					fill-rule="evenodd"
					clip-rule="evenodd"
					d="M3.404 12.5957C2.6481 11.8399 2.09028 10.9093 1.77995 9.88637C1.46961 8.86345 1.41635 7.77978 1.62488 6.73135C1.8334 5.68293 2.29728 4.70212 2.97542 3.8758C3.65355 3.04948 4.52502 2.40316 5.51261 1.99409C6.50021 1.58503 7.57344 1.42585 8.63725 1.53065C9.70106 1.63545 10.7226 2.00099 11.6114 2.5949C12.5002 3.18882 13.2288 3.99276 13.7326 4.93552C14.2365 5.87829 14.5001 6.93076 14.5 7.99972C14.5 8.33124 14.3683 8.64918 14.1339 8.88361C13.8995 9.11803 13.5815 9.24972 13.25 9.24972C12.9185 9.24972 12.6005 9.11803 12.3661 8.88361C12.1317 8.64918 12 8.33124 12 7.99972C11.9999 7.03228 11.6492 6.09766 11.0128 5.36898C10.3765 4.6403 9.49757 4.16694 8.53895 4.03659C7.58033 3.90624 6.60696 4.12773 5.79913 4.66004C4.9913 5.19234 4.40376 5.99938 4.14534 6.93167C3.88693 7.86395 3.97515 8.85831 4.39366 9.73053C4.81218 10.6028 5.53263 11.2938 6.42156 11.6755C7.31049 12.0573 8.30766 12.1039 9.22835 11.8068C10.149 11.5098 10.9309 10.8891 11.429 10.0597C11.8257 10.4103 12.3152 10.6389 12.8386 10.7181C13.3621 10.7973 13.8972 10.7237 14.3799 10.5062C14.8626 10.2887 15.2722 9.93646 15.5595 9.49185C15.8469 9.04724 15.9999 8.52912 16 7.99972C15.9999 6.14888 15.3581 4.35533 14.1839 2.92465C13.0097 1.49397 11.3757 0.514697 9.56046 0.153678C7.74517 -0.207342 5.86086 0.0722327 4.2286 0.944765C2.59633 1.8173 1.3171 3.2288 0.608871 4.93878C-0.0993615 6.64875 -0.192774 8.55139 0.344549 10.3225C0.881871 12.0936 2.01668 13.6237 3.55563 14.6519C5.09457 15.6801 6.94243 16.1429 8.78436 15.9615C10.6263 15.78 12.3483 14.9655 13.657 13.6567C13.7895 13.5145 13.8616 13.3265 13.8582 13.1322C13.8547 12.9379 13.776 12.7525 13.6386 12.6151C13.5012 12.4777 13.3158 12.399 13.1215 12.3955C12.9272 12.3921 12.7392 12.4642 12.597 12.5967C11.9934 13.2004 11.2768 13.6793 10.4881 14.006C9.69947 14.3327 8.85417 14.5008 8.0005 14.5008C7.14684 14.5008 6.30153 14.3327 5.51286 14.006C4.72419 13.6793 4.00759 13.2004 3.404 12.5967V12.5957ZM8 5.49972C7.33696 5.49972 6.70108 5.76311 6.23223 6.23195C5.76339 6.7008 5.5 7.33668 5.5 7.99972C5.5 8.66276 5.76339 9.29864 6.23223 9.76749C6.70108 10.2363 7.33696 10.4997 8 10.4997C8.66304 10.4997 9.29893 10.2363 9.76777 9.76749C10.2366 9.29864 10.5 8.66276 10.5 7.99972C10.5 7.33668 10.2366 6.7008 9.76777 6.23195C9.29893 5.76311 8.66304 5.49972 8 5.49972Z"
					fill="white"></path>
			</svg>
		</a>
	</div>
</header>

<div id="mobile-nav" popover class="mobile-nav">
	<nav class="flex flex-col" aria-label={`${SITE_TITLE} mobile navigation`}>
		{
			navItems.map((item) => (
				<a
					href={item.href}
					class:list={[
						'block px-5 py-2 no-underline',
						item.label === currentPage
							? 'text-text'
							: 'text-text-secondary',
					]}
				>
					{item.label}
				</a>
			))
		}
		<hr class="mx-5 my-1 border-t border-border" />
		<a
			href="/contact"
			class="block px-5 py-2 text-text-secondary no-underline">Contact</a
		>
	</nav>
</div>

<script>
	document.getElementById('mobile-nav')?.addEventListener('click', (e) => {
		if ((e.target as HTMLElement).closest('a')) {
			document.getElementById('mobile-nav')?.hidePopover();
		}
	});
</script>

<style>
	/* Popover requires non-utility styles for :popover-open, ::backdrop, and @starting-style */
	.mobile-nav {
		position: fixed;
		top: 3.5rem;
		right: 2rem;
		left: auto;
		margin: 0;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 11px;
		padding: 0.5rem 0;
		min-width: 10rem;
		opacity: 0;
		scale: 0.95;
		transition:
			opacity 0.15s ease,
			scale 0.15s ease,
			overlay 0.15s allow-discrete,
			display 0.15s allow-discrete;

		&:popover-open {
			opacity: 1;
			scale: 1;

			@starting-style {
				opacity: 0;
				scale: 0.95;
			}
		}

		&::backdrop {
			background: rgb(0 0 0 / 0.5);
			backdrop-filter: blur(4px);
			opacity: 0;
			transition:
				opacity 0.15s ease,
				overlay 0.15s allow-discrete,
				display 0.15s allow-discrete;
		}

		&:popover-open::backdrop {
			opacity: 1;

			@starting-style {
				opacity: 0;
			}
		}
	}
</style>
