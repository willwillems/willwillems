---
import { NAV_ITEMS, SITE_TITLE } from '../consts';
import HeaderLogo from './HeaderLogo.astro';
import AtSign from './icons/AtSign.astro';

// `build.format: 'file'` emits the home page as `/index.html`, so the raw
// pathname never equals `/`. Strip the file part (and any trailing slash) so
// every route compares against its clean href.
const pathname =
	Astro.url.pathname.replace(/(?:\/index)?\.html$/, '').replace(/\/+$/, '') ||
	'/';
const currentPage = NAV_ITEMS.find((item) =>
	pathname.startsWith(item.href),
)?.label;
---

<header
	class="relative mx-auto flex max-w-5xl items-center justify-between gap-8 px-6 sm:px-8 py-4 sm:py-6 text-sm"
>
	<HeaderLogo />
	<div class="flex items-center gap-12">
		<nav
			class="hidden items-center gap-10 sm:flex"
			aria-label={`${SITE_TITLE} primary navigation`}
		>
			{
				NAV_ITEMS.map((item) => (
					<a
						href={item.href}
						class:list={[
							'no-underline',
							item.label === currentPage
								? 'text-text-primary'
								: 'text-text-third',
						]}
					>
						{item.label}
					</a>
				))
			}
		</nav>
		<a href="/#contact" aria-label="Contact" class="hidden sm:block">
			<AtSign class="text-white" />
		</a>
		<button
			type="button"
			id="menu-toggle"
			class="-mr-2.5 flex cursor-pointer flex-col items-center gap-[6px] border-none bg-transparent p-2.5 text-white sm:hidden"
			aria-controls="site-menu"
			aria-expanded="false"
			aria-label="Menu"
		>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>
	</div>

	<nav
		id="site-menu"
		class="site-menu absolute inset-x-0 top-full bg-surface-secondary sm:hidden"
		aria-label={`${SITE_TITLE} mobile navigation`}
	>
		<ul class="flex flex-col px-6 py-5">
			{
				NAV_ITEMS.map((item) => (
					<li>
						<a
							href={item.href}
							class="type-heading-2 block py-2 font-normal text-text-secondary no-underline"
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<script>
	const root = document.documentElement;
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('site-menu');

	if (toggle && menu) {
		const setOpen = (open: boolean) => {
			// Measured rather than derived from the item count so the reveal
			// stays correct through font loading, wrapping and padding changes.
			if (open) {
				root.style.setProperty('--menu-h', `${menu.offsetHeight}px`);
			}
			root.toggleAttribute('data-menu-open', open);
			toggle.setAttribute('aria-expanded', String(open));
		};

		toggle.addEventListener('click', () => {
			setOpen(!root.hasAttribute('data-menu-open'));
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});
	}
</script>

<style>
	/* Two bars that slide together and cross into an X. `translate` and
	   `rotate` are separate properties so they interpolate independently. */
	.bar {
		width: 20px;
		height: 2px;
		background: currentColor;
		transition:
			translate 0.3s var(--menu-ease),
			rotate 0.3s var(--menu-ease);
	}

	:global(html[data-menu-open]) .bar:first-child {
		translate: 0 4px;
		rotate: 45deg;
	}

	:global(html[data-menu-open]) .bar:last-child {
		translate: 0 -4px;
		rotate: -45deg;
	}

	/* The panel is only ever painted in the strip the page content has
	   vacated: the clip and the content's translate share a duration and an
	   easing, so the reveal edge tracks the content's top edge exactly.
	   Without this the panel would paint over content that is still there —
	   nothing below the header has a background of its own to occlude it. */
	.site-menu {
		visibility: hidden;
		clip-path: inset(0 0 100% 0);
		transition:
			clip-path 0.35s var(--menu-ease),
			visibility 0s 0.35s;
	}

	:global(html[data-menu-open]) .site-menu {
		visibility: visible;
		clip-path: inset(0 0 0 0);
		transition-delay: 0s;
	}

	@media (prefers-reduced-motion: reduce) {
		.bar {
			transition: none;
		}

		.site-menu {
			transition: none;
		}
	}
</style>

<style is:global>
	:root {
		--menu-ease: cubic-bezier(0.32, 0.72, 0, 1);
		--menu-h: 0px;
	}

	/* The page content lives in the page files, so reaching it means leaving
	   component scope. Transform only — no reflow while animating. */
	main,
	footer {
		transition: translate 0.35s var(--menu-ease);
	}

	html[data-menu-open] :is(main, footer) {
		translate: 0 var(--menu-h);
	}

	@media (prefers-reduced-motion: reduce) {
		main,
		footer {
			transition: none;
		}
	}
</style>
