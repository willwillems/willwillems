---
/**
 * AI usage label from https://ai-label.org (CC0). The three symbols are
 * redrawn here as minimal inline SVGs; the official files are heavy Inkscape
 * exports with drop-shadow filters.
 */
import type { AiLabel } from '../data/ai-label';

interface Props {
	label: AiLabel;
	class?: string;
}

const { label, class: className } = Astro.props;

const TEXT: Record<AiLabel, string> = {
	no: 'No AI used',
	assisted: 'Assisted by AI',
	made: 'Made with AI',
};
---

<a
	href="https://ai-label.org"
	target="_blank"
	rel="noopener"
	title="AI label: how AI was used to make this"
	class:list={[
		'inline-flex items-center gap-1.5 hover:text-text-primary transition-colors',
		className,
	]}
>
	<svg
		class="size-[1.1em] shrink-0"
		viewBox="0 0 24 24"
		fill="currentColor"
		stroke="currentColor"
		stroke-width="2.25"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="4.5" r="2.75" stroke="none"></circle>
		<circle cx="3.5" cy="18.5" r="2.75" stroke="none"></circle>
		<circle cx="20.5" cy="18.5" r="2.75" stroke="none"></circle>
		{label === 'no' && <path d="M8 9.5 12 13l4-3.5M12 13v8" fill="none" />}
		{label === 'assisted' && <path d="M3.5 18.5h17" fill="none" />}
		{label === 'made' && <path d="M3.5 18.5 12 4.5l8.5 14" fill="none" />}
	</svg>
	{TEXT[label]}
</a>
